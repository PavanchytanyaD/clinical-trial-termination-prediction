# Copy to Data-Pipeline/airflow/.env (never committed).

# Password for the Airflow web UI user "admin"
AIRFLOW_ADMIN_PASSWORD=
# Database password (only reachable inside the Docker network)
POSTGRES_PASSWORD=airflow

# Laptop only: the gcloud folder holding the credentials the DVC remote uses.
# Leave empty on the GCP VM (it uses its service account).
GCLOUD_CONFIG_DIR=

# Linux / GCP VM: your user id, so files written in the repo stay yours
# (run `id -u`). Leave as is on macOS.
AIRFLOW_UID=50000

# DAG defaults
# source for scheduled runs: sample | zip | db
CTT_SOURCE=sample
CTT_ZIP=
CTT_ALERT_EMAILS=
