# Copy to .env (never committed) and fill in; docs/SETUP.md walks through
# every value. Environment variables win over this file. On Cloud Composer
# these come from a Kubernetes secret that ./composer/deploy.sh up creates
# from this file.

# Email alerts: data problems found by the anomaly and validation checks,
# and any task that fails its last attempt.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
# The Gmail account that sends the alerts
SMTP_USER=you@gmail.com
# A Gmail app password for that account (docs/SETUP.md, section 2), not the
# account password; spaces are ignored
SMTP_PASSWORD=
ALERT_EMAIL_FROM=you@gmail.com
# Subscribers: everyone who receives the alerts, comma-separated. To
# subscribe someone, add their address here and run ./composer/deploy.sh secret
ALERT_EMAIL_TO=you@gmail.com,teammate@example.com

# AACT database credentials (docs/SETUP.md, section 1): the database
# username and password from AACT's Database access page, not the website
# login
AACT_USER=
AACT_PASSWORD=

# Optional: log step metrics to MLflow
# MLFLOW_TRACKING_URI=http://localhost:5000
