# Copy to .env (never committed) and fill in. Environment variables win
# over this file. On Cloud Composer these come from a Kubernetes secret
# (see composer/README.md).

# Email alerts (validation failures and failed steps)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=you@example.com
# For Gmail use an app password, not your account password
SMTP_PASSWORD=
ALERT_EMAIL_FROM=you@example.com
ALERT_EMAIL_TO=teammate1@example.com,teammate2@example.com

# AACT account, only for acquire.source: db
AACT_USER=
AACT_PASSWORD=

# Optional: log step metrics to MLflow
# MLFLOW_TRACKING_URI=http://localhost:5000
