# Written by gce/vm.sh on the VM as Data-Pipeline/gce/airflow/.env (never
# committed).

# Password for the Airflow web UI user "admin" (vm.sh generates one)
AIRFLOW_ADMIN_PASSWORD=
# Database password (only reachable inside the Docker network)
POSTGRES_PASSWORD=airflow
# User id of the VM's ctt user, so files Airflow writes stay owned by it
AIRFLOW_UID=50000

# DAG defaults
# source for scheduled runs: sample | zip | db
CTT_SOURCE=sample
CTT_ZIP=
CTT_ALERT_EMAILS=
